#fix ZSH -  perform field splitting - http://zsh.sourceforge.net/Doc/Release/Options.html
# shellcheck disable=SC2148
if [ -n "$ZSH_VERSION" ]
then
    setopt SH_WORD_SPLIT
fi

function completion_wrapper() {
    local RARG='-a'
    [[ -n "$ZSH_VERSION" ]] && RARG='-A'
    # ex: completion_wrapper kgns 'get ns'
    [[ "$#" == 2 ]] || return 1
    local alias_name="$1"
    local alias_args="$2"
    eval "local alias_arg_words; alias_arg_words=($alias_args)" 2>/dev/null || return
    read $RARG alias_arg_words <<< "$alias_args"

    local compl_func="__start_kubectl"

    local wrapper_name="alias_completion::${alias_name}"
    eval "
    function ${wrapper_name}() {
      (( COMP_CWORD += ${#alias_arg_words[@]} ))
      COMP_WORDS=(kubectl $alias_args \${COMP_WORDS[@]:1})
      (( COMP_POINT -= \${#COMP_LINE} ))
      COMP_LINE=\${COMP_LINE/$alias_name/kubectl $alias_args}
      (( COMP_POINT += \${#COMP_LINE} ))
      $compl_func
      }
    "
    eval "complete -o default -F $wrapper_name $alias_name"
}

# helper functions
alias _inline_fzf="fzf --multi --ansi -i -1 --height=50% --reverse -0 --header-lines=1 --inline-info --border"
alias _inline_fzf_nh="fzf --multi --ansi -i -1 --height=50% --reverse -0 --inline-info --border"
_k8s_export() {
	yq e 'del(.metadata.resourceVersion)' -\
		| yq e 'del(.metadata.uid)' -\
		| yq e 'del(.metadata.annotations."cni.projectcalico.org/podIP")' -\
		| yq e 'del(.metadata.annotations.checksum/config)' -\
		| yq e 'del(.metadata.creationTimestamp)' -\
		| yq e 'del(.metadata.ownerReferences)' -\
		| yq e 'del(.metadata.generateName)' -\
		| yq e 'del(.metadata.selfLink)' -\
		| yq e 'del(.status)' -\
		| yq e 'del(.spec.nodeName) | del(.metadata.managedFields) | del(.specs.schedulerName)' -\
		| yq e 'del(.spec.containers[]|.volumeMounts[]|select(.mountPath == "/var/run/secrets/kubernetes.io/serviceaccount"))' -\
		| yq e 'del(.spec.containers[]|.terminationMessagePath)' -\
		| yq e 'del(.spec.containers[]|.terminationMessagePolicy)' -\
		| yq e 'del(.spec.containers[]|.imagePullPolicy)' -\
		| yq e 'del(.spec.containers[]|.dnsPolicy)' -\
		| yq e 'del(.spec.containers[]|.dnsPolicy)' -\
		| yq e 'del(.spec.containers[]|.enableServiceLinks)' -
}

		#| yq e 'del(.metadata.annotations."kubectl.kubernetes.io/last-applied-configuration")' -\
# [kexp] as former `--export` field removes unwanted metadata - usage: kexp RESOURCE
function kexp(){
	typeset -l kind
	local kind="$1"
	[ -z "$kind" ] && printf "kexp: missing argument.\nUsage: kexp RESOURCE\n" && return 255
	local cmd="kubectl get $* -oyaml"
	if [ -z "$2" ]; then
		cmd="kget $*"
	fi
	if [[ "${kind}" =~ pod? ]]; then
		local TMP_RES
		TMP_RES=$(mktemp -t k8s-res-XXXX)
		if [ -n "$2" ]; then
			kubectl get "$@" -oyaml >$TMP_RES
		else
			kubectl get po >$TMP_RES
		fi
		local k8s_sa
		k8s_sa=$(yq e '(.spec.containers[] | .volumeMounts[] | select(.mountPath == "/var/run/secrets/kubernetes.io/serviceaccount")|.name )' $TMP_RES|uniq)
		export k8s_sa
		cat $TMP_RES|_k8s_export \
			| yq e 'del(.spec.volumes[]|select(.name == env(k8s_sa)))' -
		rm -f $TMP_RES
	else
		$cmd |_k8s_export
	fi
}
completion_wrapper kexp 'get'


function _isClusterSpaceObject() {
  # caller is responsible for assuring non-empty "$1"
  obj="$1"
  kubectl api-resources --namespaced=false \
        | awk '(apiidx){print substr($0, 0, apiidx),substr($0, kindidx) } (!apiidx){ apiidx=index($0, " APIVERSION");kindidx=index($0, " KIND")}' \
    | grep -iq "\<${obj}\>"
}

