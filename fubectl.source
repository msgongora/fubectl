alias krun='kubectl run --restart=Never'; completion_wrapper krun 'run'

function krun-ci() {
    # local img="${1:-us.gcr.io/i-dss-infrastructure-prod/base-slim:latest}"
    local img
    local cmd=/bin/sh
    [[ -n "$1" ]] && img=$1 ||\
        img=$(printf "DOCKER_IMAGE
                us.gcr.io/i-dss-infrastructure-prod/base-slim
                us.gcr.io/i-dss-infrastructure-prod/base-python:3-slim
                us.gcr.io/i-dss-infrastructure-prod/base-python:3-build
                us.gcr.io/i-dss-infrastructure-prod/ci-tools:v0.3.0
                msgongora/k8s-test
                hashicorp/terraform
                gcr.io/cloud-builders/gcloud
                gcr.io/cloud-builders/kubectl
                gcr.io/cloud-builders/bazel
                gcr.io/kaniko-project/executor:debug"|awk '{print $1}'|_inline_fzf)
    [[ -n "$2" ]] && cmd=$2
    echo "$img"|grep -q kaniko && cmd=/busybox/sh
    echo "$img"|grep -Eq "gcloud|kubectl|bazel|builders/(git|go)$" && cmd=/bin/bash
    [[ -n "$img" ]] \
        && krun -i --rm  --tty --restart=Never --image-pull-policy=IfNotPresent shell-$RANDOM --image="$img" --command $cmd --overrides '{"spec":{"nodeSelector": {"node_pool": "intensive-pool"},"tolerations": [{"effect": "NoSchedule","key": "high-perform","operator": "Equal","value":"true"}],"serviceAccount":"devops-sa"}}'
}

# [kfinalizer] Remove finalizer from a namespace
function kfinalizer() {
    ns=$(kubectl get ns| _inline_fzf|awk '{print $1}')
    kubectl get ns $ns -ojson|grep -v '"kubernetes"'|\
        kubectl replace --raw "/api/v1/namespaces/$ns/finalize" -f -
}

# [kcontainers] List all pods and their containers
alias kcontainers='kubectl get po -o=custom-columns="NAME:.metadata.name,CONTAINERS:.spec.containers[*].name"'; completion_wrapper kcontainers 'get po'

# [kges] get sorted events
function kges() {
    {
        echo $'TIME\tNAMESPACE\tTYPE\tREASON\tOBJECT\tSOURCE\tMESSAGE';
        kubectl get ev -ojson "$@" \
            | jq -r  '.items | map(. + {t: (.eventTime//.lastTimestamp)}) | sort_by(.t)[] | [.t, .metadata.namespace, .type, .reason, .involvedObject.kind + "/" + .involvedObject.name, .source.component + "/" + (.source.host//"-"), .message] | @tsv';
    } \
        | column -s $'\t' -t
}

